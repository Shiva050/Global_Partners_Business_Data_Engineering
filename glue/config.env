# ============================================================================
# Glue setup configuration — `source config.env` before running the scripts.
# ============================================================================
export AWS_REGION="us-east-1"
export AWS_ACCOUNT_ID="995679261492"

# Bronze bucket already holds the DMS snapshots; Glue reads/writes here and we
# also stage the job scripts under s3://$BRONZE_BUCKET/glue/.
export BRONZE_BUCKET="dms-global-partne-brusiness-bronze"
export BRONZE_S3="s3://${BRONZE_BUCKET}"
export GLUE_S3="s3://${BRONZE_BUCKET}/glue"

# Glue service IAM role (created in step 1).
export GLUE_ROLE_NAME="gpb-glue-service-role"
export GLUE_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/${GLUE_ROLE_NAME}"

# Glue runtime.
export GLUE_VERSION="5.0"          # Spark 3.5 / Python 3.11 — matches our pyspark pin
export GLUE_WORKER_TYPE="G.1X"     # 4 vCPU / 16 GB per worker
export GLUE_NUM_WORKERS="2"        # small data; bump for larger volumes
