# ============================================================================
# Ingestion configuration — fill these in, then `source config.env`
# All DMS setup scripts and JSON templates read from these values.
# ============================================================================

# --- AWS account / region ---
export AWS_REGION="us-east-1"
export AWS_ACCOUNT_ID="000000000000"

# --- S3 bronze (raw immutable) layer ---
export BRONZE_BUCKET="gp-bronze-${AWS_ACCOUNT_ID}"     # must be globally unique
export BRONZE_PREFIX="cdc"                              # top-level folder DMS writes under
export KMS_KEY_ARN="arn:aws:kms:${AWS_REGION}:${AWS_ACCOUNT_ID}:key/CHANGE-ME"

# --- Source: SQL Server RDS ---
export RDS_ENDPOINT="gp-sqlserver.xxxxxxxx.${AWS_REGION}.rds.amazonaws.com"
export RDS_PORT="1433"
export SRC_DB_NAME="GlobalPartnerBusiness"       # database holding the 3 tables
export SRC_SCHEMA="gpb"
export SRC_USERNAME="admin"
# Password is NOT stored here — put it in Secrets Manager (see runbook §3)
export SRC_SECRET_ARN="arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:gp/rds/sqlserver-CHANGE-ME"

# --- DMS ---
export DMS_REPL_INSTANCE_ID="gp-dms-instance"
export DMS_REPL_INSTANCE_CLASS="dms.t3.medium"
export DMS_SUBNET_GROUP="gp-dms-subnet-group"
export DMS_VPC_SECURITY_GROUP="sg-CHANGE-ME"           # must reach RDS on 1433
export DMS_SOURCE_ENDPOINT_ID="gp-sqlserver-source"
export DMS_TARGET_ENDPOINT_ID="gp-s3-bronze-target"
export DMS_TASK_ID="gp-fullload-cdc-bronze"
export DMS_S3_ROLE_NAME="gp-dms-s3-target-role"
