{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteBronzeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::gp-bronze-000000000000/*"
    },
    {
      "Sid": "ListBronzeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::gp-bronze-000000000000"
    },
    {
      "Sid": "UseBronzeKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:000000000000:key/CHANGE-ME"
    }
  ]
}
